POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://bumbli:change-me@db:5432/bumbli
PORT=8080
FAMILY_LLM_MODEL=provider/model-name
# Chat money gate: set the prices to those of FAMILY_LLM_MODEL (USD per million tokens). The
# defaults match deepseek/deepseek-v4.1-flash; a pricier model is refused by the provider.
# CHAT_MAX_TOKENS=1500  # output ceiling of one chat model request
# CHAT_PRICE_IN_USD_PER_MTOK=0.051
# CHAT_PRICE_OUT_USD_PER_MTOK=0.567
# WORLD_MODEL=  # default: deepseek/deepseek-v4.1-flash; an override must support `reasoning`
OPENROUTER_API_KEY=sk-or-dummy
TELEGRAM_BOT_TOKEN=000000:dummy
TELEGRAM_WEBHOOK_SECRET=dummy-secret
TELEGRAM_WEBHOOK_URL=
# SITE_URL=https://example.com  # public origin; Telegram reminders link to {SITE_URL}/{locale}/adventure
# CHAPTER_MODEL=deepseek/deepseek-v4.1-flash
# CHAPTER_MAX_TOKENS=5500
# CHAPTER_TIMEOUT_S=90  # whole-run deadline of one chapter call (up to two requests)
# CHAPTER_RETRY_DELAY_S=5  # pause before a failed chapter call is tried again
# CHAPTER_PRICE_IN_USD_PER_MTOK=0.051
# CHAPTER_PRICE_OUT_USD_PER_MTOK=0.567
# WORLD_MAX_TOKENS=8000
# WORLD_TIMEOUT_S=75  # whole-run deadline of one world call
# WORLD_PRICE_IN_USD_PER_MTOK=0.051
# WORLD_PRICE_OUT_USD_PER_MTOK=0.567
# LLM_FAMILY_DAILY_CAP_USD=0.05
# LLM_GLOBAL_DAILY_CAP_USD=2.0
# MAX_NEW_FAMILIES_PER_DAY=60  # new games per UTC day, all callers; 0 = unlimited; the next one gets 429 daily_full
# Image calls have their own daily caps, apart from the text ones above.
# WORLD3D_MODEL=  # empty = no 3D scenes, no scene worker; marble-1.0-draft or marble-1.1 (needs WORLDLABS_API_KEY)
# WORLDLABS_API_KEY=
# IMAGE_MODEL=  # empty = no cover pictures, no image worker, no paid image call; e.g. google/gemini-3.1-flash-lite-image
# IMAGE_PRICE_USD_PER_IMAGE=0.045  # reserve ceiling of one picture (measured: 0.0336)
# IMAGE_PRICE_IN_USD_PER_MTOK=0.1  # input price that prices the prompt part of the reserve
# IMAGE_MAX_PRICE_IN_USD_PER_MTOK=5  # provider.max_price prompt cap, USD per million tokens
# IMAGE_MAX_PRICE_OUT_USD_PER_MTOK=200  # completion cap; does not bound this model's image price (probe 14.11), the bound is the reserve + worker halt
# IMAGE_TIMEOUT_S=30
# IMAGE_FAMILY_DAILY_CAP_USD=0.15  # a first cover + one text regeneration + one growth cover per UTC day (reserves ~0.047 + 0.045 + 0.047)
# IMAGE_GLOBAL_DAILY_CAP_USD=1.0
# WORLD3D_MODEL=  # empty = no 3D worlds generated, no paid world call
# WORLD3D_FAMILY_DAILY_CAP_USD=0.20  # one draft a day
# WORLD3D_GLOBAL_DAILY_CAP_USD=3.0
# SHARE_TOKEN_KEY=  # secret (>= 32 random chars after trimming surrounding whitespace; blank = unset) that derives share-link tokens; unset = world sharing refused
